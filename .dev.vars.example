# Copy file này thành .dev.vars khi chạy local với wrangler pages dev
# Trên Cloudflare Pages Dashboard: Settings -> Environment variables (chọn Encrypt cho mật khẩu/secret)

SMTP_HOST=smtp.example.com
SMTP_PORT=465
# Chọn: tls (cho port 465), starttls (cho port 587), hoặc none (port 25/2525 không mã hóa)
SMTP_SECURE=tls
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Nhôm Sắt Hữu Tiến <no-reply@huutien.net>
SMTP_TO=huutien9206@gmail.com

# Tùy chọn: Secret Key của Cloudflare Turnstile (nếu để trống thì Worker tạm bỏ qua bước kiểm tra Turnstile)
TURNSTILE_SECRET_KEY=
